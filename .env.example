# Serveur Nuxt (dev: valeurs par défaut de `nuxt dev`)
HOST=0.0.0.0
PORT=3000

# API — appels SSR (côté serveur), joint le conteneur API directement.
# Surcharge runtimeConfig.apiBase (nuxt.config.ts)
NUXT_API_BASE=http://laravel.test

# API — appels navigateur, passe par le port publié de l'API.
# Surcharge runtimeConfig.public.apiBase (nuxt.config.ts)
NUXT_PUBLIC_API_BASE=http://localhost
